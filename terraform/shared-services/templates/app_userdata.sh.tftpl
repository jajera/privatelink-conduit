#!/bin/bash
set -euo pipefail

# Install packages via S3 gateway endpoint (no NAT).
dnf install -y python3 python3-pip python3-psycopg2 amazon-ssm-agent || dnf install -y python3 python3-pip amazon-ssm-agent
systemctl enable amazon-ssm-agent
systemctl restart amazon-ssm-agent

# Prefer distro psycopg2; fall back to pip if needed (requires connectivity).
python3 -c "import psycopg2" 2>/dev/null || pip3 install --quiet psycopg2-binary

install -d /opt/config-api

cat >/opt/config-api/server.py <<'PY'
#!/usr/bin/env python3
import json
import os
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

import psycopg2

DB = {
    "host": os.environ["DB_HOST"],
    "port": os.environ["DB_PORT"],
    "dbname": os.environ["DB_NAME"],
    "user": os.environ["DB_USER"],
    "password": os.environ["DB_PASSWORD"],
}


def connect_with_retry(retries=30, delay=5):
    last = None
    for _ in range(retries):
        try:
            return psycopg2.connect(**DB)
        except Exception as exc:  # noqa: BLE001
            last = exc
            time.sleep(delay)
    raise RuntimeError(f"could not connect to database: {last}")


def init_db():
    conn = connect_with_retry()
    conn.autocommit = True
    with conn.cursor() as cur:
        cur.execute(
            """
            CREATE TABLE IF NOT EXISTS configs (
              key TEXT PRIMARY KEY,
              value TEXT NOT NULL
            )
            """
        )
        cur.execute(
            """
            INSERT INTO configs (key, value) VALUES
              ('feature.dark_mode', 'true'),
              ('feature.beta_banner', 'false'),
              ('app.greeting', 'hello from privatelink-conduit')
            ON CONFLICT (key) DO NOTHING
            """
        )
    conn.close()


class Handler(BaseHTTPRequestHandler):
    def _json(self, code, payload):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):  # noqa: N802
        if self.path == "/health":
            self._json(200, {"status": "ok"})
            return
        if self.path == "/v1/config":
            try:
                conn = psycopg2.connect(**DB)
                with conn.cursor() as cur:
                    cur.execute("SELECT key, value FROM configs ORDER BY key")
                    rows = {k: v for k, v in cur.fetchall()}
                conn.close()
                self._json(200, {"configs": rows, "source": "rds"})
            except Exception as exc:  # noqa: BLE001
                self._json(500, {"error": str(exc)})
            return
        self._json(404, {"error": "not found"})

    def log_message(self, fmt, *args):
        return


if __name__ == "__main__":
    init_db()
    HTTPServer(("0.0.0.0", 80), Handler).serve_forever()
PY

chmod +x /opt/config-api/server.py

cat >/etc/systemd/system/config-api.service <<EOF
[Unit]
Description=PrivateLink conduit config API
After=network-online.target
Wants=network-online.target

[Service]
Environment=DB_HOST=${db_host}
Environment=DB_PORT=${db_port}
Environment=DB_NAME=${db_name}
Environment=DB_USER=${db_user}
Environment=DB_PASSWORD=${db_password}
ExecStart=/usr/bin/python3 /opt/config-api/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now config-api
